// For format details, see https://aka.ms/devcontainer.json.
{
  "name": "Zola",
  "image": "ubuntu:latest",

  "forwardPorts": [
    // Zola server
    1111
  ],

  "postCreateCommand": "apt update && apt install -y curl ca-certificates && curl -sSfL https://github.com/getzola/zola/releases/download/v0.23.6/zola-v0.23.6-$(uname -m)-unknown-linux-gnu.tar.gz | tar -xz -C /usr/local/bin zola",

  "postAttachCommand": "zola serve --interface 0.0.0.0 --base-url localhost"
}
